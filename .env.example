# Fixora AI Environment Configuration
# Copy to .env and fill in values

# OpenAI API Key (optional - for enhanced AI responses)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_VISION_MODEL=gpt-4o-mini

# Agentverse & ACP Configuration
AGENT_NAME=fixora_ai
AGENT_SEED_PHRASE=your_unique_seed_phrase_here
AGENT_MAILBOX_KEY=your_agentverse_mailbox_key_here
AGENTVERSE_API_KEY=your_agentverse_api_key_here

# Database
DATABASE_PATH=database/fixora.db

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
